<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Id="IWebClassroom.Agent"
           Name="iWebClassroom Agent"
           Manufacturer="Fundação Salesianos"
           Version="$(var.ProductVersion)"
           UpgradeCode="{94F4D627-8591-4E68-B64D-F7B1F5DC8D3B}"
           Scope="perMachine"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version is already installed. / Já está instalada uma versão mais recente. / Ya está instalada una versión más reciente." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Property Id="SERVERURL" Secure="yes">
      <RegistrySearch Id="InstalledAgentServerUrl"
                      Root="HKLM"
                      Key="SOFTWARE\iWebClassroom\Agent"
                      Name="ServerUrl"
                      Type="raw"
                      Bitness="always64" />
    </Property>
    <Property Id="INSTALLLANGUAGE" Value="pt-PT" Secure="yes">
      <RegistrySearch Id="InstalledAgentLanguage"
                      Root="HKLM"
                      Key="SOFTWARE\iWebClassroom\Agent"
                      Name="InstallLanguage"
                      Type="raw"
                      Bitness="always64" />
    </Property>
    <Property Id="ASSIGNMENTMODE" Value="Fixed" Secure="yes">
      <RegistrySearch Id="InstalledAgentAssignmentMode"
                      Root="HKLM"
                      Key="SOFTWARE\iWebClassroom\Agent"
                      Name="AssignmentMode"
                      Type="raw"
                      Bitness="always64" />
    </Property>
    <Property Id="CLASSROOMID" Value="SALA-1" Secure="yes">
      <RegistrySearch Id="InstalledAgentClassroomId"
                      Root="HKLM"
                      Key="SOFTWARE\iWebClassroom\Agent"
                      Name="ClassroomId"
                      Type="raw"
                      Bitness="always64" />
    </Property>

    <CustomAction Id="RequireServerUrl"
                  Error="Specify SERVERURL, for example SERVERURL=https://classroom.school.local. / Indique SERVERURL. / Indique SERVERURL." />
    <InstallExecuteSequence>
      <Custom Action="RequireServerUrl"
              Before="InstallInitialize"
              Condition="NOT Installed AND NOT SERVERURL" />
    </InstallExecuteSequence>

    <UI Id="AgentInstallerUI">
      <TextStyle Id="DlgFont8" FaceName="Segoe UI" Size="9" />
      <TextStyle Id="DlgTitleFont" FaceName="Segoe UI" Size="13" Bold="yes" />
      <Property Id="DefaultUIFont" Value="DlgFont8" />

      <Dialog Id="AgentConfigurationDlg" Width="370" Height="350" Title="iWebClassroom Agent">
        <Control Id="Title" Type="Text" X="20" Y="15" Width="330" Height="22" Transparent="yes" NoPrefix="yes" TabSkip="no"
                 Text="{\DlgTitleFont}Instalação / Setup / Instalación" />
        <Control Id="Description" Type="Text" X="20" Y="43" Width="330" Height="28" Transparent="yes" NoPrefix="yes"
                 Text="Configure o agente antes de instalar. / Configure the agent before installation. / Configure el agente antes de instalar." />
        <Control Id="LanguageLabel" Type="Text" X="20" Y="83" Width="330" Height="15" Text="Idioma / Language / Idioma" />
        <Control Id="Language" Type="ComboBox" X="20" Y="100" Width="200" Height="18" Property="INSTALLLANGUAGE" ComboList="yes">
          <ComboBox Property="INSTALLLANGUAGE">
            <ListItem Text="Português (Portugal)" Value="pt-PT" />
            <ListItem Text="English" Value="en-US" />
            <ListItem Text="Español" Value="es-ES" />
          </ComboBox>
        </Control>
        <Control Id="AssignmentModeLabel" Type="Text" X="20" Y="132" Width="330" Height="15"
                 Text="Utilização / Usage / Uso" />
        <Control Id="AssignmentMode" Type="ComboBox" X="20" Y="149" Width="330" Height="18" Property="ASSIGNMENTMODE" ComboList="yes">
          <ComboBox Property="ASSIGNMENTMODE">
            <ListItem Text="Sala fixa / Fixed room / Aula fija" Value="Fixed" />
            <ListItem Text="Computador partilhado / Shared computer / Equipo compartido" Value="Shared" />
          </ComboBox>
        </Control>
        <Control Id="ClassroomIdLabel" Type="Text" X="20" Y="181" Width="330" Height="15"
                 Text="Código da sala fixa / Fixed room code / Código del aula fija" />
        <Control Id="ClassroomId" Type="Edit" X="20" Y="198" Width="200" Height="18" Property="CLASSROOMID" />
        <Control Id="ClassroomIdHint" Type="Text" X="225" Y="195" Width="125" Height="30" Transparent="yes" NoPrefix="yes"
                 Text="Ignorado no modo partilhado / Ignored in shared mode / Ignorado en modo compartido" />
        <Control Id="ServerUrlLabel" Type="Text" X="20" Y="225" Width="330" Height="15"
                 Text="Endereço do servidor local / Local server address / Dirección del servidor local" />
        <Control Id="ServerUrl" Type="Edit" X="20" Y="243" Width="330" Height="18" Property="SERVERURL" />
        <Control Id="ServerUrlHint" Type="Text" X="20" Y="266" Width="330" Height="25" Transparent="yes" NoPrefix="yes"
                 Text="Ex.: https://192.168.1.10:7443 — o certificado seguro é instalado automaticamente no primeiro registo." />
        <Control Id="BottomLine" Type="Line" X="0" Y="305" Width="370" Height="0" />
        <Control Id="Cancel" Type="PushButton" X="220" Y="319" Width="65" Height="18" Cancel="yes" Text="Cancelar / Cancel">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
        <Control Id="Install" Type="PushButton" X="292" Y="319" Width="58" Height="18" Default="yes" Text="Instalar / Install">
          <Publish Event="SpawnDialog" Value="MissingServerDlg" Condition="NOT SERVERURL" />
          <Publish Event="EndDialog" Value="Return" Condition="SERVERURL" />
        </Control>
      </Dialog>

      <Dialog Id="MissingServerDlg" Width="300" Height="95" Title="iWebClassroom Agent">
        <Control Id="Message" Type="Text" X="18" Y="15" Width="264" Height="42" NoPrefix="yes"
                 Text="Indique o endereço do servidor local. / Enter the local server address. / Indique la dirección del servidor local." />
        <Control Id="OK" Type="PushButton" X="122" Y="65" Width="56" Height="18" Default="yes" Cancel="yes" Text="OK">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
      </Dialog>

      <Dialog Id="AgentProgressDlg" Width="370" Height="270" Title="iWebClassroom Agent" Modeless="yes">
        <Control Id="Title" Type="Text" X="20" Y="15" Width="330" Height="22" Transparent="yes" NoPrefix="yes" TabSkip="no"
                 Text="{\DlgTitleFont}A instalar / Installing / Instalando" />
        <Control Id="Description" Type="Text" X="20" Y="48" Width="330" Height="36" Transparent="yes" NoPrefix="yes"
                 Text="Aguarde enquanto o agente é instalado. / Please wait while the agent is installed. / Espere mientras se instala el agente." />
        <Control Id="ActionText" Type="Text" X="20" Y="112" Width="330" Height="18" NoPrefix="yes">
          <Subscribe Event="ActionText" Attribute="Text" />
        </Control>
        <Control Id="ProgressBar" Type="ProgressBar" X="20" Y="138" Width="330" Height="12" ProgressBlocks="yes" Text="Progresso / Progress / Progreso">
          <Subscribe Event="SetProgress" Attribute="Progress" />
        </Control>
        <Control Id="BottomLine" Type="Line" X="0" Y="225" Width="370" Height="0" />
        <Control Id="Wait" Type="Text" X="20" Y="239" Width="330" Height="18" Transparent="yes" NoPrefix="yes"
                 Text="Não desligue o computador. / Do not turn off the computer. / No apague el equipo." />
      </Dialog>

      <Dialog Id="AgentSuccessDlg" Width="370" Height="230" Title="iWebClassroom Agent">
        <Control Id="Title" Type="Text" X="20" Y="20" Width="330" Height="25" Transparent="yes" NoPrefix="yes"
                 Text="{\DlgTitleFont}Instalação concluída / Installation complete / Instalación completada" />
        <Control Id="Description" Type="Text" X="20" Y="62" Width="330" Height="70" Transparent="yes" NoPrefix="yes"
                 Text="O agente foi instalado e configurado para [SERVERURL]. / The agent was installed and configured for [SERVERURL]. / El agente se instaló y configuró para [SERVERURL]." />
        <Control Id="BottomLine" Type="Line" X="0" Y="185" Width="370" Height="0" />
        <Control Id="Finish" Type="PushButton" X="282" Y="199" Width="68" Height="18" Default="yes" Cancel="yes" Text="Concluir / Finish">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
      </Dialog>

      <Dialog Id="AgentErrorDlg" Width="370" Height="190" Title="iWebClassroom Agent">
        <Control Id="Title" Type="Text" X="20" Y="20" Width="330" Height="25" Transparent="yes" NoPrefix="yes"
                 Text="{\DlgTitleFont}Falha na instalação / Installation failed / Error de instalación" />
        <Control Id="Description" Type="Text" X="20" Y="62" Width="330" Height="55" Transparent="yes" NoPrefix="yes"
                 Text="O agente não foi instalado. Consulte o registo do Windows Installer. / The agent was not installed. Check the Windows Installer log. / El agente no se instaló. Consulte el registro de Windows Installer." />
        <Control Id="BottomLine" Type="Line" X="0" Y="145" Width="370" Height="0" />
        <Control Id="Finish" Type="PushButton" X="282" Y="159" Width="68" Height="18" Default="yes" Cancel="yes" Text="Fechar / Close">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>

      <Dialog Id="AgentCancelledDlg" Width="370" Height="190" Title="iWebClassroom Agent">
        <Control Id="Title" Type="Text" X="20" Y="20" Width="330" Height="25" Transparent="yes" NoPrefix="yes"
                 Text="{\DlgTitleFont}Instalação cancelada / Installation cancelled / Instalación cancelada" />
        <Control Id="Description" Type="Text" X="20" Y="62" Width="330" Height="45" Transparent="yes" NoPrefix="yes"
                 Text="Não foram efetuadas alterações. / No changes were made. / No se realizaron cambios." />
        <Control Id="BottomLine" Type="Line" X="0" Y="145" Width="370" Height="0" />
        <Control Id="Finish" Type="PushButton" X="282" Y="159" Width="68" Height="18" Default="yes" Cancel="yes" Text="Fechar / Close">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>

      <InstallUISequence>
        <Show Dialog="AgentConfigurationDlg" After="CostFinalize" Condition="NOT Installed" />
        <Show Dialog="AgentProgressDlg" Before="ExecuteAction" />
        <Show Dialog="AgentSuccessDlg" OnExit="success" />
        <Show Dialog="AgentErrorDlg" OnExit="error" />
        <Show Dialog="AgentCancelledDlg" OnExit="cancel" />
      </InstallUISequence>
    </UI>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="AgentCompanyFolder" Name="iWebClassroom">
        <Directory Id="INSTALLFOLDER" Name="Agent" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AgentProgramsFolder" Name="iWebClassroom" />
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="AgentDataCompanyFolder" Name="iWebClassroom">
        <Directory Id="AGENTDATADIR" Name="Agent" />
      </Directory>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="iWebClassroom Agent" Level="1">
      <Files Include="$(var.PublishDir)\**\*" Directory="INSTALLFOLDER">
        <Exclude Files="$(var.PublishDir)\**\*.pdb" />
        <Exclude Files="$(var.PublishDir)\iWebClassroom.Agent.exe" />
      </Files>
      <ComponentRef Id="AgentExecutableComponent" />
      <ComponentRef Id="AgentStartupComponent" />
      <ComponentRef Id="AgentDataDirectory" />
      <ComponentRef Id="AgentInstallerConfiguration" />
    </Feature>
  </Package>

  <Fragment>
    <Component Id="AgentExecutableComponent" Directory="INSTALLFOLDER" Bitness="always64">
      <File Id="AgentExecutable"
            Source="$(var.PublishDir)\iWebClassroom.Agent.exe"
            KeyPath="yes">
        <Shortcut Id="AgentStartMenuShortcut"
                  Directory="AgentProgramsFolder"
                  Name="iWebClassroom Agent"
                  Description="iWebClassroom classroom agent"
                  Advertise="yes" />
      </File>
      <RemoveFolder Id="RemoveAgentProgramsFolder" Directory="AgentProgramsFolder" On="uninstall" />
    </Component>

    <Component Id="AgentStartupComponent" Directory="INSTALLFOLDER" Bitness="always64">
      <RegistryValue Root="HKLM"
                     Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Run"
                     Name="iWebClassroom Agent"
                     Type="string"
                     Value="&quot;[INSTALLFOLDER]iWebClassroom.Agent.exe&quot;"
                     KeyPath="yes" />
    </Component>

    <Component Id="AgentDataDirectory" Directory="AGENTDATADIR" Bitness="always64" Permanent="yes">
      <CreateFolder>
        <PermissionEx Sddl="D:PAI(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;0x1301bf;;;AU)" />
      </CreateFolder>
      <RegistryValue Root="HKLM"
                     Key="SOFTWARE\iWebClassroom\Agent"
                     Name="DataDirectoryCreated"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>

    <Component Id="AgentInstallerConfiguration" Directory="AGENTDATADIR" Bitness="always64">
      <RegistryValue Root="HKLM"
                     Key="SOFTWARE\iWebClassroom\Agent"
                     Name="ServerUrl"
                     Type="string"
                     Value="[SERVERURL]" />
      <RegistryValue Root="HKLM"
                     Key="SOFTWARE\iWebClassroom\Agent"
                     Name="AssignmentMode"
                     Type="string"
                     Value="[ASSIGNMENTMODE]" />
      <RegistryValue Root="HKLM"
                     Key="SOFTWARE\iWebClassroom\Agent"
                     Name="ClassroomId"
                     Type="string"
                     Value="[CLASSROOMID]" />
      <RegistryValue Root="HKLM"
                     Key="SOFTWARE\iWebClassroom\Agent"
                     Name="InstallLanguage"
                     Type="string"
                     Value="[INSTALLLANGUAGE]"
                     KeyPath="yes" />
    </Component>
  </Fragment>
</Wix>
