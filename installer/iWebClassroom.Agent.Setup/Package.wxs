<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Id="IWebClassroom.Agent"
           Name="iWebClassroom Agent"
           Manufacturer="Fundação Salesianos"
           Version="$(var.ProductVersion)"
           UpgradeCode="{94F4D627-8591-4E68-B64D-F7B1F5DC8D3B}"
           Scope="perMachine"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version is already installed. / Já está instalada uma versão mais recente. / Ya está instalada una versión más reciente." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Property Id="SERVERURL" Secure="yes">
      <RegistrySearch Id="InstalledAgentServerUrl"
                      Root="HKLM"
                      Key="SOFTWARE\iWebClassroom\Agent"
                      Name="ServerUrl"
                      Type="raw"
                      Bitness="always64" />
    </Property>
    <Property Id="INSTALLLANGUAGE" Value="pt-PT" Secure="yes">
      <RegistrySearch Id="InstalledAgentLanguage"
                      Root="HKLM"
                      Key="SOFTWARE\iWebClassroom\Agent"
                      Name="InstallLanguage"
                      Type="raw"
                      Bitness="always64" />
    </Property>
    <Property Id="UI_CONFIG_TITLE" Value="Instalação do agente" />
    <Property Id="UI_CONFIG_DESC" Value="Indique apenas o endereço do servidor. A sala e a função serão atribuídas pelo administrador na Cloud." />
    <Property Id="UI_SERVER_LABEL" Value="Endereço do servidor local" />
    <Property Id="UI_SERVER_HINT" Value="Ex.: https://192.168.1.10:7443 — o certificado seguro será instalado automaticamente." />
    <Property Id="UI_CANCEL" Value="Cancelar" /><Property Id="UI_NEXT" Value="Continuar" /><Property Id="UI_INSTALL" Value="Instalar" />
    <Property Id="UI_MISSING_SERVER" Value="Indique o endereço do servidor local." />
    <Property Id="UI_INSTALLING_TITLE" Value="A instalar" /><Property Id="UI_INSTALLING_DESC" Value="Aguarde enquanto o agente é instalado." /><Property Id="UI_WAIT" Value="Não desligue o computador." />
    <Property Id="UI_SUCCESS_TITLE" Value="Instalação concluída" /><Property Id="UI_SUCCESS_DESC" Value="O agente foi instalado. O computador aparecerá na Cloud para ser atribuído pelo administrador." /><Property Id="UI_FINISH" Value="Concluir" />
    <Property Id="UI_ERROR_TITLE" Value="Falha na instalação" /><Property Id="UI_ERROR_DESC" Value="O agente não foi instalado. Consulte o registo do Windows Installer." /><Property Id="UI_CLOSE" Value="Fechar" />
    <Property Id="UI_CANCELLED_TITLE" Value="Instalação cancelada" /><Property Id="UI_CANCELLED_DESC" Value="Não foram efetuadas alterações." />

    <CustomAction Id="RequireServerUrl"
                  Error="Specify SERVERURL, for example SERVERURL=https://classroom.school.local. / Indique SERVERURL. / Indique SERVERURL." />
    <InstallExecuteSequence>
      <Custom Action="RequireServerUrl"
              Before="InstallInitialize"
              Condition="NOT Installed AND NOT SERVERURL" />
    </InstallExecuteSequence>

    <UI Id="AgentInstallerUI">
      <TextStyle Id="DlgFont8" FaceName="Segoe UI" Size="9" />
      <TextStyle Id="DlgTitleFont" FaceName="Segoe UI" Size="13" Bold="yes" />
      <Property Id="DefaultUIFont" Value="DlgFont8" />

      <Dialog Id="AgentLanguageDlg" Width="370" Height="210" Title="iWebClassroom Agent">
        <Control Id="Title" Type="Text" X="20" Y="20" Width="330" Height="25" Transparent="yes" NoPrefix="yes" Text="{\DlgTitleFont}Idioma / Language / Idioma" />
        <Control Id="Description" Type="Text" X="20" Y="55" Width="330" Height="25" Transparent="yes" NoPrefix="yes" Text="Escolha o idioma da instalação / Choose the setup language / Elija el idioma de instalación" />
        <Control Id="Language" Type="ComboBox" X="20" Y="94" Width="220" Height="18" Property="INSTALLLANGUAGE" ComboList="yes"><ComboBox Property="INSTALLLANGUAGE"><ListItem Text="Português (Portugal)" Value="pt-PT" /><ListItem Text="English" Value="en-US" /><ListItem Text="Español" Value="es-ES" /></ComboBox></Control>
        <Control Id="BottomLine" Type="Line" X="0" Y="165" Width="370" Height="0" />
        <Control Id="Cancel" Type="PushButton" X="210" Y="179" Width="68" Height="18" Cancel="yes" Text="Cancel"><Publish Event="EndDialog" Value="Exit" /></Control>
        <Control Id="Next" Type="PushButton" X="285" Y="179" Width="65" Height="18" Default="yes" Text="Next &gt;">
          <Publish Property="UI_CONFIG_TITLE" Value="Agent setup" Condition="INSTALLLANGUAGE=&quot;en-US&quot;" /><Publish Property="UI_CONFIG_TITLE" Value="Instalación del agente" Condition="INSTALLLANGUAGE=&quot;es-ES&quot;" />
          <Publish Property="UI_CONFIG_DESC" Value="Enter only the server address. The room and role will be assigned by the administrator in the Cloud." Condition="INSTALLLANGUAGE=&quot;en-US&quot;" /><Publish Property="UI_CONFIG_DESC" Value="Indique solo la dirección del servidor. El aula y la función serán asignadas por el administrador en la nube." Condition="INSTALLLANGUAGE=&quot;es-ES&quot;" />
          <Publish Property="UI_SERVER_LABEL" Value="Local server address" Condition="INSTALLLANGUAGE=&quot;en-US&quot;" /><Publish Property="UI_SERVER_LABEL" Value="Dirección del servidor local" Condition="INSTALLLANGUAGE=&quot;es-ES&quot;" />
          <Publish Property="UI_SERVER_HINT" Value="E.g. https://192.168.1.10:7443 — the secure certificate will be installed automatically." Condition="INSTALLLANGUAGE=&quot;en-US&quot;" /><Publish Property="UI_SERVER_HINT" Value="Ej.: https://192.168.1.10:7443 — el certificado seguro se instalará automáticamente." Condition="INSTALLLANGUAGE=&quot;es-ES&quot;" />
          <Publish Property="UI_CANCEL" Value="Cancel" Condition="INSTALLLANGUAGE=&quot;en-US&quot;" /><Publish Property="UI_CANCEL" Value="Cancelar" Condition="INSTALLLANGUAGE=&quot;es-ES&quot;" />
          <Publish Property="UI_INSTALL" Value="Install" Condition="INSTALLLANGUAGE=&quot;en-US&quot;" /><Publish Property="UI_INSTALL" Value="Instalar" Condition="INSTALLLANGUAGE=&quot;es-ES&quot;" />
          <Publish Property="UI_MISSING_SERVER" Value="Enter the local server address." Condition="INSTALLLANGUAGE=&quot;en-US&quot;" /><Publish Property="UI_MISSING_SERVER" Value="Indique la dirección del servidor local." Condition="INSTALLLANGUAGE=&quot;es-ES&quot;" />
          <Publish Property="UI_INSTALLING_TITLE" Value="Installing" Condition="INSTALLLANGUAGE=&quot;en-US&quot;" /><Publish Property="UI_INSTALLING_TITLE" Value="Instalando" Condition="INSTALLLANGUAGE=&quot;es-ES&quot;" />
          <Publish Property="UI_INSTALLING_DESC" Value="Please wait while the agent is installed." Condition="INSTALLLANGUAGE=&quot;en-US&quot;" /><Publish Property="UI_INSTALLING_DESC" Value="Espere mientras se instala el agente." Condition="INSTALLLANGUAGE=&quot;es-ES&quot;" />
          <Publish Property="UI_WAIT" Value="Do not turn off the computer." Condition="INSTALLLANGUAGE=&quot;en-US&quot;" /><Publish Property="UI_WAIT" Value="No apague el equipo." Condition="INSTALLLANGUAGE=&quot;es-ES&quot;" />
          <Publish Property="UI_SUCCESS_TITLE" Value="Installation complete" Condition="INSTALLLANGUAGE=&quot;en-US&quot;" /><Publish Property="UI_SUCCESS_TITLE" Value="Instalación completada" Condition="INSTALLLANGUAGE=&quot;es-ES&quot;" />
          <Publish Property="UI_SUCCESS_DESC" Value="The agent was installed. The computer will appear in the Cloud for administrator assignment." Condition="INSTALLLANGUAGE=&quot;en-US&quot;" /><Publish Property="UI_SUCCESS_DESC" Value="El agente se instaló. El ordenador aparecerá en la nube para que el administrador lo asigne." Condition="INSTALLLANGUAGE=&quot;es-ES&quot;" />
          <Publish Property="UI_FINISH" Value="Finish" Condition="INSTALLLANGUAGE=&quot;en-US&quot;" /><Publish Property="UI_FINISH" Value="Finalizar" Condition="INSTALLLANGUAGE=&quot;es-ES&quot;" />
          <Publish Property="UI_ERROR_TITLE" Value="Installation failed" Condition="INSTALLLANGUAGE=&quot;en-US&quot;" /><Publish Property="UI_ERROR_TITLE" Value="Error de instalación" Condition="INSTALLLANGUAGE=&quot;es-ES&quot;" />
          <Publish Property="UI_ERROR_DESC" Value="The agent was not installed. Check the Windows Installer log." Condition="INSTALLLANGUAGE=&quot;en-US&quot;" /><Publish Property="UI_ERROR_DESC" Value="El agente no se instaló. Consulte el registro de Windows Installer." Condition="INSTALLLANGUAGE=&quot;es-ES&quot;" />
          <Publish Property="UI_CLOSE" Value="Close" Condition="INSTALLLANGUAGE=&quot;en-US&quot;" /><Publish Property="UI_CLOSE" Value="Cerrar" Condition="INSTALLLANGUAGE=&quot;es-ES&quot;" />
          <Publish Property="UI_CANCELLED_TITLE" Value="Installation cancelled" Condition="INSTALLLANGUAGE=&quot;en-US&quot;" /><Publish Property="UI_CANCELLED_TITLE" Value="Instalación cancelada" Condition="INSTALLLANGUAGE=&quot;es-ES&quot;" />
          <Publish Property="UI_CANCELLED_DESC" Value="No changes were made." Condition="INSTALLLANGUAGE=&quot;en-US&quot;" /><Publish Property="UI_CANCELLED_DESC" Value="No se realizaron cambios." Condition="INSTALLLANGUAGE=&quot;es-ES&quot;" />
          <Publish Event="NewDialog" Value="AgentConfigurationDlg" />
        </Control>
      </Dialog>

      <Dialog Id="AgentConfigurationDlg" Width="370" Height="260" Title="iWebClassroom Agent">
        <Control Id="Title" Type="Text" X="20" Y="15" Width="330" Height="22" Transparent="yes" NoPrefix="yes" TabSkip="no"
                 Text="{\DlgTitleFont}[UI_CONFIG_TITLE]" />
        <Control Id="Description" Type="Text" X="20" Y="43" Width="330" Height="28" Transparent="yes" NoPrefix="yes"
                 Text="[UI_CONFIG_DESC]" />
        <Control Id="ServerUrlLabel" Type="Text" X="20" Y="92" Width="330" Height="15" Text="[UI_SERVER_LABEL]" />
        <Control Id="ServerUrl" Type="Edit" X="20" Y="110" Width="330" Height="18" Property="SERVERURL" />
        <Control Id="ServerUrlHint" Type="Text" X="20" Y="134" Width="330" Height="36" Transparent="yes" NoPrefix="yes" Text="[UI_SERVER_HINT]" />
        <Control Id="BottomLine" Type="Line" X="0" Y="215" Width="370" Height="0" />
        <Control Id="Cancel" Type="PushButton" X="220" Y="229" Width="65" Height="18" Cancel="yes" Text="[UI_CANCEL]">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
        <Control Id="Install" Type="PushButton" X="292" Y="229" Width="58" Height="18" Default="yes" Text="[UI_INSTALL]">
          <Publish Event="SpawnDialog" Value="MissingServerDlg" Condition="NOT SERVERURL" />
          <Publish Event="EndDialog" Value="Return" Condition="SERVERURL" />
        </Control>
      </Dialog>

      <Dialog Id="MissingServerDlg" Width="300" Height="95" Title="iWebClassroom Agent">
        <Control Id="Message" Type="Text" X="18" Y="15" Width="264" Height="42" NoPrefix="yes"
                 Text="[UI_MISSING_SERVER]" />
        <Control Id="OK" Type="PushButton" X="122" Y="65" Width="56" Height="18" Default="yes" Cancel="yes" Text="OK">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
      </Dialog>

      <Dialog Id="AgentProgressDlg" Width="370" Height="270" Title="iWebClassroom Agent" Modeless="yes">
        <Control Id="Title" Type="Text" X="20" Y="15" Width="330" Height="22" Transparent="yes" NoPrefix="yes" TabSkip="no"
                 Text="{\DlgTitleFont}[UI_INSTALLING_TITLE]" />
        <Control Id="Description" Type="Text" X="20" Y="48" Width="330" Height="36" Transparent="yes" NoPrefix="yes"
                 Text="[UI_INSTALLING_DESC]" />
        <Control Id="ActionText" Type="Text" X="20" Y="112" Width="330" Height="18" NoPrefix="yes">
          <Subscribe Event="ActionText" Attribute="Text" />
        </Control>
        <Control Id="ProgressBar" Type="ProgressBar" X="20" Y="138" Width="330" Height="12" ProgressBlocks="yes" Text="Progress">
          <Subscribe Event="SetProgress" Attribute="Progress" />
        </Control>
        <Control Id="BottomLine" Type="Line" X="0" Y="225" Width="370" Height="0" />
        <Control Id="Wait" Type="Text" X="20" Y="239" Width="330" Height="18" Transparent="yes" NoPrefix="yes"
                 Text="[UI_WAIT]" />
      </Dialog>

      <Dialog Id="AgentSuccessDlg" Width="370" Height="230" Title="iWebClassroom Agent">
        <Control Id="Title" Type="Text" X="20" Y="20" Width="330" Height="25" Transparent="yes" NoPrefix="yes"
                 Text="{\DlgTitleFont}[UI_SUCCESS_TITLE]" />
        <Control Id="Description" Type="Text" X="20" Y="62" Width="330" Height="70" Transparent="yes" NoPrefix="yes"
                 Text="[UI_SUCCESS_DESC]" />
        <Control Id="BottomLine" Type="Line" X="0" Y="185" Width="370" Height="0" />
        <Control Id="Finish" Type="PushButton" X="282" Y="199" Width="68" Height="18" Default="yes" Cancel="yes" Text="[UI_FINISH]">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
      </Dialog>

      <Dialog Id="AgentErrorDlg" Width="370" Height="190" Title="iWebClassroom Agent">
        <Control Id="Title" Type="Text" X="20" Y="20" Width="330" Height="25" Transparent="yes" NoPrefix="yes"
                 Text="{\DlgTitleFont}[UI_ERROR_TITLE]" />
        <Control Id="Description" Type="Text" X="20" Y="62" Width="330" Height="55" Transparent="yes" NoPrefix="yes"
                 Text="[UI_ERROR_DESC]" />
        <Control Id="BottomLine" Type="Line" X="0" Y="145" Width="370" Height="0" />
        <Control Id="Finish" Type="PushButton" X="282" Y="159" Width="68" Height="18" Default="yes" Cancel="yes" Text="[UI_CLOSE]">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>

      <Dialog Id="AgentCancelledDlg" Width="370" Height="190" Title="iWebClassroom Agent">
        <Control Id="Title" Type="Text" X="20" Y="20" Width="330" Height="25" Transparent="yes" NoPrefix="yes"
                 Text="{\DlgTitleFont}[UI_CANCELLED_TITLE]" />
        <Control Id="Description" Type="Text" X="20" Y="62" Width="330" Height="45" Transparent="yes" NoPrefix="yes"
                 Text="[UI_CANCELLED_DESC]" />
        <Control Id="BottomLine" Type="Line" X="0" Y="145" Width="370" Height="0" />
        <Control Id="Finish" Type="PushButton" X="282" Y="159" Width="68" Height="18" Default="yes" Cancel="yes" Text="[UI_CLOSE]">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>

      <InstallUISequence>
        <Show Dialog="AgentLanguageDlg" After="CostFinalize" Condition="NOT Installed" />
        <Show Dialog="AgentProgressDlg" Before="ExecuteAction" />
        <Show Dialog="AgentSuccessDlg" OnExit="success" />
        <Show Dialog="AgentErrorDlg" OnExit="error" />
        <Show Dialog="AgentCancelledDlg" OnExit="cancel" />
      </InstallUISequence>
    </UI>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="AgentCompanyFolder" Name="iWebClassroom">
        <Directory Id="INSTALLFOLDER" Name="Agent" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AgentProgramsFolder" Name="iWebClassroom" />
    </StandardDirectory>

    <!-- In a per-machine MSI, DesktopFolder is resolved by Windows Installer to the shared desktop. -->
    <StandardDirectory Id="DesktopFolder" />

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="AgentDataCompanyFolder" Name="iWebClassroom">
        <Directory Id="AGENTDATADIR" Name="Agent" />
      </Directory>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="iWebClassroom Agent" Level="1">
      <Files Include="$(var.PublishDir)\**\*" Directory="INSTALLFOLDER">
        <Exclude Files="$(var.PublishDir)\**\*.pdb" />
        <Exclude Files="$(var.PublishDir)\iWebClassroom.Agent.exe" />
      </Files>
      <ComponentRef Id="AgentExecutableComponent" />
      <ComponentRef Id="AgentStartupComponent" />
      <ComponentRef Id="AgentDataDirectory" />
      <ComponentRef Id="AgentInstallerConfiguration" />
    </Feature>
  </Package>

  <Fragment>
    <Component Id="AgentExecutableComponent" Directory="INSTALLFOLDER" Bitness="always64">
      <File Id="AgentExecutable"
            Source="$(var.PublishDir)\iWebClassroom.Agent.exe"
            KeyPath="yes">
        <Shortcut Id="AgentStartMenuShortcut"
                  Directory="AgentProgramsFolder"
                  Name="iWebClassroom Agent"
                  Description="iWebClassroom classroom agent"
                  Advertise="yes" />
        <Shortcut Id="AgentDesktopShortcut"
                  Directory="DesktopFolder"
                  Name="iWebClassroom"
                  Description="iWebClassroom Agent"
                  Advertise="yes" />
      </File>
      <RemoveFolder Id="RemoveAgentProgramsFolder" Directory="AgentProgramsFolder" On="uninstall" />
    </Component>

    <Component Id="AgentStartupComponent" Directory="INSTALLFOLDER" Bitness="always64">
      <RegistryValue Root="HKLM"
                     Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Run"
                     Name="iWebClassroom Agent"
                     Type="string"
                     Value="&quot;[INSTALLFOLDER]iWebClassroom.Agent.exe&quot;"
                     KeyPath="yes" />
    </Component>

    <Component Id="AgentDataDirectory" Directory="AGENTDATADIR" Bitness="always64" Permanent="yes">
      <CreateFolder>
        <PermissionEx Sddl="D:PAI(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;0x1301bf;;;AU)" />
      </CreateFolder>
      <RegistryValue Root="HKLM"
                     Key="SOFTWARE\iWebClassroom\Agent"
                     Name="DataDirectoryCreated"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>

    <Component Id="AgentInstallerConfiguration" Directory="AGENTDATADIR" Bitness="always64">
      <RegistryValue Root="HKLM"
                     Key="SOFTWARE\iWebClassroom\Agent"
                     Name="ServerUrl"
                     Type="string"
                     Value="[SERVERURL]" />
      <RegistryValue Root="HKLM"
                     Key="SOFTWARE\iWebClassroom\Agent"
                     Name="InstallLanguage"
                     Type="string"
                     Value="[INSTALLLANGUAGE]"
                     KeyPath="yes" />
    </Component>
  </Fragment>
</Wix>
