<Project Sdk="WixToolset.Sdk/7.0.1">
  <PropertyGroup>
    <AcceptEula>wix7</AcceptEula>
    <Cultures>pt-PT;en-US;es-ES</Cultures>
    <InstallerPlatform>x64</InstallerPlatform>
    <OutputType>Package</OutputType>
    <OutputName>iWebClassroom-Server-$(ProductVersion)-win-x64</OutputName>
    <ProductVersion Condition="'$(ProductVersion)' == ''">1.0.0</ProductVersion>
    <PublishDir Condition="'$(PublishDir)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\server</PublishDir>
    <DefineConstants>ProductVersion=$(ProductVersion);PublishDir=$(PublishDir)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" Version="7.0.1" />
  </ItemGroup>
</Project>
