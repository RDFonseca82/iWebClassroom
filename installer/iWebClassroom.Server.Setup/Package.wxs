<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
     xmlns:fire="http://wixtoolset.org/schemas/v4/wxs/firewall">
  <Package Id="IWebClassroom.Server"
           Name="iWebClassroom Server"
           Manufacturer="Fundação Salesianos"
           Version="$(var.ProductVersion)"
           UpgradeCode="{F68834C1-FCB7-4825-A6AA-E9B96E3F897D}"
           Scope="perMachine"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version is already installed. / Já está instalada uma versão mais recente. / Ya está instalada una versión más reciente." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Property Id="INSTALLLANGUAGE" Value="pt-PT" Secure="yes">
      <RegistrySearch Id="InstalledServerLanguage"
                      Root="HKLM"
                      Key="SOFTWARE\iWebClassroom\Server"
                      Name="InstallLanguage"
                      Type="raw"
                      Bitness="always64" />
    </Property>

    <UI Id="ServerInstallerUI">
      <TextStyle Id="DlgFont8" FaceName="Segoe UI" Size="9" />
      <TextStyle Id="DlgTitleFont" FaceName="Segoe UI" Size="13" Bold="yes" />
      <Property Id="DefaultUIFont" Value="DlgFont8" />

      <Dialog Id="ServerConfigurationDlg" Width="370" Height="230" Title="iWebClassroom Server">
        <Control Id="Title" Type="Text" X="20" Y="15" Width="330" Height="22" Transparent="yes" NoPrefix="yes" TabSkip="no"
                 Text="{\DlgTitleFont}Instalação / Setup / Instalación" />
        <Control Id="Description" Type="Text" X="20" Y="43" Width="330" Height="36" Transparent="yes" NoPrefix="yes"
                 Text="Escolha o idioma inicial das consolas. / Choose the initial console language. / Elija el idioma inicial de las consolas." />
        <Control Id="LanguageLabel" Type="Text" X="20" Y="94" Width="330" Height="15" Text="Idioma / Language / Idioma" />
        <Control Id="Language" Type="ComboBox" X="20" Y="112" Width="200" Height="18" Property="INSTALLLANGUAGE" ComboList="yes">
          <ComboBox Property="INSTALLLANGUAGE">
            <ListItem Text="Português (Portugal)" Value="pt-PT" />
            <ListItem Text="English" Value="en-US" />
            <ListItem Text="Español" Value="es-ES" />
          </ComboBox>
        </Control>
        <Control Id="BottomLine" Type="Line" X="0" Y="185" Width="370" Height="0" />
        <Control Id="Cancel" Type="PushButton" X="220" Y="199" Width="65" Height="18" Cancel="yes" Text="Cancelar / Cancel">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
        <Control Id="Install" Type="PushButton" X="292" Y="199" Width="58" Height="18" Default="yes" Text="Instalar / Install">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
      </Dialog>

      <Dialog Id="ServerProgressDlg" Width="370" Height="230" Title="iWebClassroom Server" Modeless="yes">
        <Control Id="Title" Type="Text" X="20" Y="15" Width="330" Height="22" Transparent="yes" NoPrefix="yes" TabSkip="no"
                 Text="{\DlgTitleFont}A instalar / Installing / Instalando" />
        <Control Id="Description" Type="Text" X="20" Y="48" Width="330" Height="36" Transparent="yes" NoPrefix="yes"
                 Text="Aguarde enquanto o servidor é instalado. / Please wait while the server is installed. / Espere mientras se instala el servidor." />
        <Control Id="ActionText" Type="Text" X="20" Y="102" Width="330" Height="18" NoPrefix="yes">
          <Subscribe Event="ActionText" Attribute="Text" />
        </Control>
        <Control Id="ProgressBar" Type="ProgressBar" X="20" Y="128" Width="330" Height="12" ProgressBlocks="yes" Text="Progresso / Progress / Progreso">
          <Subscribe Event="SetProgress" Attribute="Progress" />
        </Control>
        <Control Id="BottomLine" Type="Line" X="0" Y="185" Width="370" Height="0" />
        <Control Id="Wait" Type="Text" X="20" Y="199" Width="330" Height="18" Transparent="yes" NoPrefix="yes"
                 Text="Não desligue o computador. / Do not turn off the computer. / No apague el equipo." />
      </Dialog>

      <Dialog Id="ServerSuccessDlg" Width="370" Height="230" Title="iWebClassroom Server">
        <Control Id="Title" Type="Text" X="20" Y="20" Width="330" Height="25" Transparent="yes" NoPrefix="yes"
                 Text="{\DlgTitleFont}Instalação concluída / Installation complete / Instalación completada" />
        <Control Id="Description" Type="Text" X="20" Y="62" Width="330" Height="70" Transparent="yes" NoPrefix="yes"
                 Text="O servidor foi instalado. A consola segura está disponível em https://localhost:7443 e em todos os IP deste servidor. / The server was installed. The secure console is available at https://localhost:7443 and on every server IP. / El servidor se instaló. La consola segura está disponible en https://localhost:7443 y en todas las IP del servidor." />
        <Control Id="BottomLine" Type="Line" X="0" Y="185" Width="370" Height="0" />
        <Control Id="Finish" Type="PushButton" X="282" Y="199" Width="68" Height="18" Default="yes" Cancel="yes" Text="Concluir / Finish">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
      </Dialog>

      <Dialog Id="ServerErrorDlg" Width="370" Height="190" Title="iWebClassroom Server">
        <Control Id="Title" Type="Text" X="20" Y="20" Width="330" Height="25" Transparent="yes" NoPrefix="yes"
                 Text="{\DlgTitleFont}Falha na instalação / Installation failed / Error de instalación" />
        <Control Id="Description" Type="Text" X="20" Y="62" Width="330" Height="55" Transparent="yes" NoPrefix="yes"
                 Text="O servidor não foi instalado. Consulte o registo do Windows Installer. / The server was not installed. Check the Windows Installer log. / El servidor no se instaló. Consulte el registro de Windows Installer." />
        <Control Id="BottomLine" Type="Line" X="0" Y="145" Width="370" Height="0" />
        <Control Id="Finish" Type="PushButton" X="282" Y="159" Width="68" Height="18" Default="yes" Cancel="yes" Text="Fechar / Close">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>

      <Dialog Id="ServerCancelledDlg" Width="370" Height="190" Title="iWebClassroom Server">
        <Control Id="Title" Type="Text" X="20" Y="20" Width="330" Height="25" Transparent="yes" NoPrefix="yes"
                 Text="{\DlgTitleFont}Instalação cancelada / Installation cancelled / Instalación cancelada" />
        <Control Id="Description" Type="Text" X="20" Y="62" Width="330" Height="45" Transparent="yes" NoPrefix="yes"
                 Text="Não foram efetuadas alterações. / No changes were made. / No se realizaron cambios." />
        <Control Id="BottomLine" Type="Line" X="0" Y="145" Width="370" Height="0" />
        <Control Id="Finish" Type="PushButton" X="282" Y="159" Width="68" Height="18" Default="yes" Cancel="yes" Text="Fechar / Close">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>

      <InstallUISequence>
        <Show Dialog="ServerConfigurationDlg" After="CostFinalize" Condition="NOT Installed" />
        <Show Dialog="ServerProgressDlg" Before="ExecuteAction" />
        <Show Dialog="ServerSuccessDlg" OnExit="success" />
        <Show Dialog="ServerErrorDlg" OnExit="error" />
        <Show Dialog="ServerCancelledDlg" OnExit="cancel" />
      </InstallUISequence>
    </UI>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="ServerCompanyFolder" Name="iWebClassroom">
        <Directory Id="INSTALLFOLDER" Name="Server" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="ServerDataCompanyFolder" Name="iWebClassroom">
        <Directory Id="SERVERDATADIR" Name="Server" />
      </Directory>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="iWebClassroom Server" Level="1">
      <Files Include="$(var.PublishDir)\**\*" Directory="INSTALLFOLDER">
        <Exclude Files="$(var.PublishDir)\**\*.pdb" />
        <Exclude Files="$(var.PublishDir)\iWebClassroom.Server.exe" />
      </Files>
      <ComponentRef Id="ServerService" />
      <ComponentRef Id="ServerDataDirectory" />
      <ComponentRef Id="ServerMachineSettings" />
      <ComponentRef Id="ServerInstallerConfiguration" />
    </Feature>
  </Package>

  <Fragment>
    <Component Id="ServerService" Directory="INSTALLFOLDER" Bitness="always64">
      <File Id="ServerExecutable"
            Source="$(var.PublishDir)\iWebClassroom.Server.exe"
            KeyPath="yes" />
      <fire:FirewallException Id="ServerHttpFirewall"
                              Name="iWebClassroom Server HTTP bootstrap"
                              Port="7080"
                              Protocol="tcp"
                              Scope="localSubnet"
                              Profile="all" />
      <fire:FirewallException Id="ServerHttpsFirewall"
                              Name="iWebClassroom Server HTTPS"
                              Port="7443"
                              Protocol="tcp"
                              Scope="localSubnet"
                              Profile="all" />
      <ServiceInstall Id="InstallServerService"
                      Name="iWebClassroom.Server"
                      DisplayName="iWebClassroom Server"
                      Description="iWebClassroom local classroom management server"
                      Type="ownProcess"
                      Start="auto"
                      ErrorControl="normal"
                      Vital="yes">
        <util:ServiceConfig FirstFailureActionType="restart"
                            SecondFailureActionType="restart"
                            ThirdFailureActionType="restart"
                            RestartServiceDelayInSeconds="30"
                            ResetPeriodInDays="1" />
      </ServiceInstall>
      <ServiceControl Id="ControlServerService"
                      Name="iWebClassroom.Server"
                      Start="install"
                      Stop="both"
                      Remove="uninstall"
                      Wait="yes" />
    </Component>

    <Component Id="ServerDataDirectory" Directory="SERVERDATADIR" Bitness="always64" Permanent="yes">
      <CreateFolder>
        <PermissionEx Sddl="D:PAI(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)" />
      </CreateFolder>
      <RegistryValue Root="HKLM"
                     Key="SOFTWARE\iWebClassroom\Server"
                     Name="DataDirectoryCreated"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>

    <Component Id="ServerMachineSettings"
               Directory="SERVERDATADIR"
               Bitness="always64"
               Permanent="yes"
               NeverOverwrite="yes">
      <File Id="ServerMachineSettingsFile"
            Source="$(var.InstallerSourceDir)\appsettings.Installer.json"
            Name="appsettings.Local.json"
            KeyPath="yes" />
    </Component>

    <Component Id="ServerInstallerConfiguration" Directory="SERVERDATADIR" Bitness="always64">
      <RegistryValue Root="HKLM"
                     Key="SOFTWARE\iWebClassroom\Server"
                     Name="InstallLanguage"
                     Type="string"
                     Value="[INSTALLLANGUAGE]"
                     KeyPath="yes" />
    </Component>
  </Fragment>
</Wix>
