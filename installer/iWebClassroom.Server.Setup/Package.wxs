<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
     xmlns:fire="http://wixtoolset.org/schemas/v4/wxs/firewall">
  <Package Id="IWebClassroom.Server"
           Name="iWebClassroom Server"
           Manufacturer="Fundação Salesianos"
           Version="$(var.ProductVersion)"
           UpgradeCode="{F68834C1-FCB7-4825-A6AA-E9B96E3F897D}"
           Scope="perMachine"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version is already installed. / Já está instalada uma versão mais recente. / Ya está instalada una versión más reciente." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Property Id="INSTALLLANGUAGE" Value="pt-PT" Secure="yes">
      <RegistrySearch Id="InstalledServerLanguage"
                      Root="HKLM"
                      Key="SOFTWARE\iWebClassroom\Server"
                      Name="InstallLanguage"
                      Type="raw"
                      Bitness="always64" />
    </Property>
    <Property Id="UI_CONFIG_TITLE" Value="Instalação do servidor" /><Property Id="UI_CONFIG_DESC" Value="O servidor está pronto para ser instalado em Português de Portugal." />
    <Property Id="UI_CANCEL" Value="Cancelar" /><Property Id="UI_INSTALL" Value="Instalar" />
    <Property Id="UI_RETRY" Value="Tentar novamente" /><Property Id="UI_IGNORE" Value="Ignorar" /><Property Id="UI_EXIT" Value="Sair" /><Property Id="UI_YES" Value="Sim" /><Property Id="UI_NO" Value="Não" />
    <Property Id="UI_FILES_TITLE" Value="Ficheiros em utilização" /><Property Id="UI_FILES_TEXT" Value="Feche as aplicações indicadas antes de continuar a atualização." /><Property Id="UI_RM_TEXT" Value="O Windows pode fechar e reiniciar estas aplicações automaticamente." />
    <Property Id="UI_INSTALLING_TITLE" Value="A instalar" /><Property Id="UI_INSTALLING_DESC" Value="Aguarde enquanto o servidor é instalado." /><Property Id="UI_WAIT" Value="Não desligue o computador." />
    <Property Id="UI_SUCCESS_TITLE" Value="Instalação concluída" /><Property Id="UI_SUCCESS_DESC" Value="O servidor foi instalado. A consola segura está disponível em https://localhost:7443 e em todos os IP deste servidor." /><Property Id="UI_FINISH" Value="Concluir" />
    <Property Id="UI_ERROR_TITLE" Value="Falha na instalação" /><Property Id="UI_ERROR_DESC" Value="O servidor não foi instalado. Consulte o registo do Windows Installer." /><Property Id="UI_CLOSE" Value="Fechar" />
    <Property Id="UI_CANCELLED_TITLE" Value="Instalação cancelada" /><Property Id="UI_CANCELLED_DESC" Value="Não foram efetuadas alterações." />

    <UI Id="ServerInstallerUI">
      <TextStyle Id="DlgFont8" FaceName="Segoe UI" Size="9" />
      <TextStyle Id="DlgTitleFont" FaceName="Segoe UI" Size="13" Bold="yes" />
      <Property Id="DefaultUIFont" Value="DlgFont8" />
      <Property Id="ErrorDialog" Value="ErrorDlg" />

      <Dialog Id="ErrorDlg" Width="270" Height="105" Title="iWebClassroom Server" ErrorDialog="yes">
        <Control Id="ErrorText" Type="Text" X="15" Y="15" Width="240" Height="55" TabSkip="no" NoPrefix="yes" Text="Information text" />
        <Control Id="Y" Type="PushButton" X="107" Y="80" Width="56" Height="17" TabSkip="yes" Text="[UI_YES]"><Publish Event="EndDialog" Value="ErrorYes" /></Control>
        <Control Id="A" Type="PushButton" X="107" Y="80" Width="56" Height="17" TabSkip="yes" Text="[UI_CANCEL]"><Publish Event="EndDialog" Value="ErrorAbort" /></Control>
        <Control Id="C" Type="PushButton" X="107" Y="80" Width="56" Height="17" TabSkip="yes" Text="[UI_CANCEL]"><Publish Event="EndDialog" Value="ErrorCancel" /></Control>
        <Control Id="I" Type="PushButton" X="107" Y="80" Width="56" Height="17" TabSkip="yes" Text="[UI_IGNORE]"><Publish Event="EndDialog" Value="ErrorIgnore" /></Control>
        <Control Id="N" Type="PushButton" X="107" Y="80" Width="56" Height="17" TabSkip="yes" Text="[UI_NO]"><Publish Event="EndDialog" Value="ErrorNo" /></Control>
        <Control Id="O" Type="PushButton" X="107" Y="80" Width="56" Height="17" TabSkip="yes" Text="OK"><Publish Event="EndDialog" Value="ErrorOk" /></Control>
        <Control Id="R" Type="PushButton" X="107" Y="80" Width="56" Height="17" TabSkip="yes" Text="[UI_RETRY]"><Publish Event="EndDialog" Value="ErrorRetry" /></Control>
      </Dialog>

      <Dialog Id="FilesInUse" Width="370" Height="270" Title="iWebClassroom Server" KeepModeless="yes">
        <Control Id="Title" Type="Text" X="20" Y="15" Width="330" Height="22" Transparent="yes" NoPrefix="yes" Text="{\DlgTitleFont}[UI_FILES_TITLE]" />
        <Control Id="Text" Type="Text" X="20" Y="48" Width="330" Height="32" NoPrefix="yes" Text="[UI_FILES_TEXT]" />
        <Control Id="List" Type="ListBox" X="20" Y="88" Width="330" Height="130" Property="FileInUseProcess" Sunken="yes" TabSkip="yes" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Exit" Type="PushButton" X="166" Y="243" Width="56" Height="17" Text="[UI_EXIT]"><Publish Event="EndDialog" Value="Exit" /></Control>
        <Control Id="Ignore" Type="PushButton" X="235" Y="243" Width="56" Height="17" Text="[UI_IGNORE]"><Publish Event="EndDialog" Value="Ignore" /></Control>
        <Control Id="Retry" Type="PushButton" X="304" Y="243" Width="56" Height="17" Default="yes" Cancel="yes" Text="[UI_RETRY]"><Publish Event="EndDialog" Value="Retry" /></Control>
      </Dialog>

      <Dialog Id="MsiRMFilesInUse" Width="370" Height="240" Title="iWebClassroom Server" KeepModeless="yes">
        <Control Id="Title" Type="Text" X="20" Y="15" Width="330" Height="22" Transparent="yes" NoPrefix="yes" Text="{\DlgTitleFont}[UI_FILES_TITLE]" />
        <Control Id="Text" Type="Text" X="20" Y="48" Width="330" Height="38" NoPrefix="yes" Text="[UI_RM_TEXT]" />
        <Control Id="List" Type="ListBox" X="20" Y="92" Width="330" Height="100" Property="FileInUseProcess" Sunken="yes" TabSkip="yes" />
        <Control Id="BottomLine" Type="Line" X="0" Y="204" Width="370" Height="0" />
        <Control Id="Cancel" Type="PushButton" X="235" Y="215" Width="56" Height="17" Cancel="yes" Text="[UI_CANCEL]"><Publish Event="EndDialog" Value="Exit" /></Control>
        <Control Id="OK" Type="PushButton" X="304" Y="215" Width="56" Height="17" Default="yes" Text="OK"><Publish Event="EndDialog" Value="Return" /><Publish Event="RMShutdownAndRestart" Value="0" /></Control>
      </Dialog>

      <Dialog Id="ServerLanguageDlg" Width="370" Height="210" Title="iWebClassroom Server">
        <Control Id="Title" Type="Text" X="20" Y="20" Width="330" Height="25" Transparent="yes" NoPrefix="yes" Text="{\DlgTitleFont}Idioma / Language / Idioma" />
        <Control Id="Description" Type="Text" X="20" Y="55" Width="330" Height="25" Transparent="yes" NoPrefix="yes" Text="Escolha o idioma da instalação / Choose the setup language / Elija el idioma de instalación" />
        <Control Id="Language" Type="ComboBox" X="20" Y="94" Width="220" Height="18" Property="INSTALLLANGUAGE" ComboList="yes"><ComboBox Property="INSTALLLANGUAGE"><ListItem Text="Português (Portugal)" Value="pt-PT" /><ListItem Text="English" Value="en-US" /><ListItem Text="Español" Value="es-ES" /></ComboBox></Control>
        <Control Id="BottomLine" Type="Line" X="0" Y="165" Width="370" Height="0" />
        <Control Id="Cancel" Type="PushButton" X="210" Y="179" Width="68" Height="18" Cancel="yes" Text="Cancelar / Cancel"><Publish Event="EndDialog" Value="Exit" /></Control>
        <Control Id="Next" Type="PushButton" X="285" Y="179" Width="65" Height="18" Default="yes" Text="Next &gt;">
          <Publish Property="UI_CONFIG_TITLE" Value="Server setup" Condition="INSTALLLANGUAGE=&quot;en-US&quot;" /><Publish Property="UI_CONFIG_TITLE" Value="Instalación del servidor" Condition="INSTALLLANGUAGE=&quot;es-ES&quot;" />
          <Publish Property="UI_CONFIG_DESC" Value="The server is ready to be installed in English." Condition="INSTALLLANGUAGE=&quot;en-US&quot;" /><Publish Property="UI_CONFIG_DESC" Value="El servidor está listo para instalarse en español." Condition="INSTALLLANGUAGE=&quot;es-ES&quot;" />
          <Publish Property="UI_CANCEL" Value="Cancel" Condition="INSTALLLANGUAGE=&quot;en-US&quot;" /><Publish Property="UI_CANCEL" Value="Cancelar" Condition="INSTALLLANGUAGE=&quot;es-ES&quot;" />
          <Publish Property="UI_RETRY" Value="Retry" Condition="INSTALLLANGUAGE=&quot;en-US&quot;" /><Publish Property="UI_RETRY" Value="Reintentar" Condition="INSTALLLANGUAGE=&quot;es-ES&quot;" />
          <Publish Property="UI_IGNORE" Value="Ignore" Condition="INSTALLLANGUAGE=&quot;en-US&quot;" /><Publish Property="UI_IGNORE" Value="Ignorar" Condition="INSTALLLANGUAGE=&quot;es-ES&quot;" />
          <Publish Property="UI_EXIT" Value="Exit" Condition="INSTALLLANGUAGE=&quot;en-US&quot;" /><Publish Property="UI_EXIT" Value="Salir" Condition="INSTALLLANGUAGE=&quot;es-ES&quot;" />
          <Publish Property="UI_YES" Value="Yes" Condition="INSTALLLANGUAGE=&quot;en-US&quot;" /><Publish Property="UI_YES" Value="Sí" Condition="INSTALLLANGUAGE=&quot;es-ES&quot;" />
          <Publish Property="UI_NO" Value="No" Condition="INSTALLLANGUAGE=&quot;en-US&quot;" /><Publish Property="UI_NO" Value="No" Condition="INSTALLLANGUAGE=&quot;es-ES&quot;" />
          <Publish Property="UI_FILES_TITLE" Value="Files in use" Condition="INSTALLLANGUAGE=&quot;en-US&quot;" /><Publish Property="UI_FILES_TITLE" Value="Archivos en uso" Condition="INSTALLLANGUAGE=&quot;es-ES&quot;" />
          <Publish Property="UI_FILES_TEXT" Value="Close the listed applications before continuing the update." Condition="INSTALLLANGUAGE=&quot;en-US&quot;" /><Publish Property="UI_FILES_TEXT" Value="Cierre las aplicaciones indicadas antes de continuar la actualización." Condition="INSTALLLANGUAGE=&quot;es-ES&quot;" />
          <Publish Property="UI_RM_TEXT" Value="Windows can close and restart these applications automatically." Condition="INSTALLLANGUAGE=&quot;en-US&quot;" /><Publish Property="UI_RM_TEXT" Value="Windows puede cerrar y reiniciar estas aplicaciones automáticamente." Condition="INSTALLLANGUAGE=&quot;es-ES&quot;" />
          <Publish Property="UI_INSTALL" Value="Install" Condition="INSTALLLANGUAGE=&quot;en-US&quot;" /><Publish Property="UI_INSTALL" Value="Instalar" Condition="INSTALLLANGUAGE=&quot;es-ES&quot;" />
          <Publish Property="UI_INSTALLING_TITLE" Value="Installing" Condition="INSTALLLANGUAGE=&quot;en-US&quot;" /><Publish Property="UI_INSTALLING_TITLE" Value="Instalando" Condition="INSTALLLANGUAGE=&quot;es-ES&quot;" />
          <Publish Property="UI_INSTALLING_DESC" Value="Please wait while the server is installed." Condition="INSTALLLANGUAGE=&quot;en-US&quot;" /><Publish Property="UI_INSTALLING_DESC" Value="Espere mientras se instala el servidor." Condition="INSTALLLANGUAGE=&quot;es-ES&quot;" />
          <Publish Property="UI_WAIT" Value="Do not turn off the computer." Condition="INSTALLLANGUAGE=&quot;en-US&quot;" /><Publish Property="UI_WAIT" Value="No apague el equipo." Condition="INSTALLLANGUAGE=&quot;es-ES&quot;" />
          <Publish Property="UI_SUCCESS_TITLE" Value="Installation complete" Condition="INSTALLLANGUAGE=&quot;en-US&quot;" /><Publish Property="UI_SUCCESS_TITLE" Value="Instalación completada" Condition="INSTALLLANGUAGE=&quot;es-ES&quot;" />
          <Publish Property="UI_SUCCESS_DESC" Value="The server was installed. The secure console is available at https://localhost:7443 and on every server IP." Condition="INSTALLLANGUAGE=&quot;en-US&quot;" /><Publish Property="UI_SUCCESS_DESC" Value="El servidor se instaló. La consola segura está disponible en https://localhost:7443 y en todas las IP del servidor." Condition="INSTALLLANGUAGE=&quot;es-ES&quot;" />
          <Publish Property="UI_FINISH" Value="Finish" Condition="INSTALLLANGUAGE=&quot;en-US&quot;" /><Publish Property="UI_FINISH" Value="Finalizar" Condition="INSTALLLANGUAGE=&quot;es-ES&quot;" />
          <Publish Property="UI_ERROR_TITLE" Value="Installation failed" Condition="INSTALLLANGUAGE=&quot;en-US&quot;" /><Publish Property="UI_ERROR_TITLE" Value="Error de instalación" Condition="INSTALLLANGUAGE=&quot;es-ES&quot;" />
          <Publish Property="UI_ERROR_DESC" Value="The server was not installed. Check the Windows Installer log." Condition="INSTALLLANGUAGE=&quot;en-US&quot;" /><Publish Property="UI_ERROR_DESC" Value="El servidor no se instaló. Consulte el registro de Windows Installer." Condition="INSTALLLANGUAGE=&quot;es-ES&quot;" />
          <Publish Property="UI_CLOSE" Value="Close" Condition="INSTALLLANGUAGE=&quot;en-US&quot;" /><Publish Property="UI_CLOSE" Value="Cerrar" Condition="INSTALLLANGUAGE=&quot;es-ES&quot;" />
          <Publish Property="UI_CANCELLED_TITLE" Value="Installation cancelled" Condition="INSTALLLANGUAGE=&quot;en-US&quot;" /><Publish Property="UI_CANCELLED_TITLE" Value="Instalación cancelada" Condition="INSTALLLANGUAGE=&quot;es-ES&quot;" />
          <Publish Property="UI_CANCELLED_DESC" Value="No changes were made." Condition="INSTALLLANGUAGE=&quot;en-US&quot;" /><Publish Property="UI_CANCELLED_DESC" Value="No se realizaron cambios." Condition="INSTALLLANGUAGE=&quot;es-ES&quot;" />
          <Publish Event="NewDialog" Value="ServerConfigurationDlg" />
        </Control>
      </Dialog>

      <Dialog Id="ServerConfigurationDlg" Width="370" Height="230" Title="iWebClassroom Server">
        <Control Id="Title" Type="Text" X="20" Y="15" Width="330" Height="22" Transparent="yes" NoPrefix="yes" TabSkip="no"
                 Text="{\DlgTitleFont}[UI_CONFIG_TITLE]" />
        <Control Id="Description" Type="Text" X="20" Y="43" Width="330" Height="36" Transparent="yes" NoPrefix="yes"
                 Text="[UI_CONFIG_DESC]" />
        <Control Id="BottomLine" Type="Line" X="0" Y="185" Width="370" Height="0" />
        <Control Id="Cancel" Type="PushButton" X="220" Y="199" Width="65" Height="18" Cancel="yes" Text="[UI_CANCEL]">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
        <Control Id="Install" Type="PushButton" X="292" Y="199" Width="58" Height="18" Default="yes" Text="[UI_INSTALL]">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
      </Dialog>

      <Dialog Id="ServerProgressDlg" Width="370" Height="230" Title="iWebClassroom Server" Modeless="yes">
        <Control Id="Title" Type="Text" X="20" Y="15" Width="330" Height="22" Transparent="yes" NoPrefix="yes" TabSkip="no"
                 Text="{\DlgTitleFont}[UI_INSTALLING_TITLE]" />
        <Control Id="Description" Type="Text" X="20" Y="48" Width="330" Height="36" Transparent="yes" NoPrefix="yes"
                 Text="[UI_INSTALLING_DESC]" />
        <Control Id="ActionText" Type="Text" X="20" Y="102" Width="330" Height="18" NoPrefix="yes">
          <Subscribe Event="ActionText" Attribute="Text" />
        </Control>
        <Control Id="ProgressBar" Type="ProgressBar" X="20" Y="128" Width="330" Height="12" ProgressBlocks="yes" Text="Progress">
          <Subscribe Event="SetProgress" Attribute="Progress" />
        </Control>
        <Control Id="BottomLine" Type="Line" X="0" Y="185" Width="370" Height="0" />
        <Control Id="Wait" Type="Text" X="20" Y="199" Width="330" Height="18" Transparent="yes" NoPrefix="yes"
                 Text="[UI_WAIT]" />
      </Dialog>

      <Dialog Id="ExitDialog" Width="370" Height="230" Title="iWebClassroom Server">
        <Control Id="Title" Type="Text" X="20" Y="20" Width="330" Height="25" Transparent="yes" NoPrefix="yes"
                 Text="{\DlgTitleFont}[UI_SUCCESS_TITLE]" />
        <Control Id="Description" Type="Text" X="20" Y="62" Width="330" Height="70" Transparent="yes" NoPrefix="yes"
                 Text="[UI_SUCCESS_DESC]" />
        <Control Id="BottomLine" Type="Line" X="0" Y="185" Width="370" Height="0" />
        <Control Id="Finish" Type="PushButton" X="282" Y="199" Width="68" Height="18" Default="yes" Cancel="yes" Text="[UI_FINISH]">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
      </Dialog>

      <Dialog Id="FatalError" Width="370" Height="190" Title="iWebClassroom Server">
        <Control Id="Title" Type="Text" X="20" Y="20" Width="330" Height="25" Transparent="yes" NoPrefix="yes"
                 Text="{\DlgTitleFont}[UI_ERROR_TITLE]" />
        <Control Id="Description" Type="Text" X="20" Y="62" Width="330" Height="55" Transparent="yes" NoPrefix="yes"
                 Text="[UI_ERROR_DESC]" />
        <Control Id="BottomLine" Type="Line" X="0" Y="145" Width="370" Height="0" />
        <Control Id="Finish" Type="PushButton" X="282" Y="159" Width="68" Height="18" Default="yes" Cancel="yes" Text="[UI_CLOSE]">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>

      <Dialog Id="UserExit" Width="370" Height="190" Title="iWebClassroom Server">
        <Control Id="Title" Type="Text" X="20" Y="20" Width="330" Height="25" Transparent="yes" NoPrefix="yes"
                 Text="{\DlgTitleFont}[UI_CANCELLED_TITLE]" />
        <Control Id="Description" Type="Text" X="20" Y="62" Width="330" Height="45" Transparent="yes" NoPrefix="yes"
                 Text="[UI_CANCELLED_DESC]" />
        <Control Id="BottomLine" Type="Line" X="0" Y="145" Width="370" Height="0" />
        <Control Id="Finish" Type="PushButton" X="282" Y="159" Width="68" Height="18" Default="yes" Cancel="yes" Text="[UI_CLOSE]">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>

      <InstallUISequence>
        <Show Dialog="ServerLanguageDlg" After="CostFinalize" Condition="NOT Installed" />
        <Show Dialog="ServerProgressDlg" Before="ExecuteAction" />
        <Show Dialog="ExitDialog" OnExit="success" />
        <Show Dialog="FatalError" OnExit="error" />
        <Show Dialog="UserExit" OnExit="cancel" />
      </InstallUISequence>
      <AdminUISequence>
        <Show Dialog="ExitDialog" OnExit="success" />
        <Show Dialog="FatalError" OnExit="error" />
        <Show Dialog="UserExit" OnExit="cancel" />
      </AdminUISequence>
    </UI>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="ServerCompanyFolder" Name="iWebClassroom">
        <Directory Id="INSTALLFOLDER" Name="Server" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="ServerDataCompanyFolder" Name="iWebClassroom">
        <Directory Id="SERVERDATADIR" Name="Server" />
      </Directory>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="iWebClassroom Server" Level="1">
      <Files Include="$(var.PublishDir)\**\*" Directory="INSTALLFOLDER">
        <Exclude Files="$(var.PublishDir)\**\*.pdb" />
        <Exclude Files="$(var.PublishDir)\iWebClassroom.Server.exe" />
      </Files>
      <ComponentRef Id="ServerService" />
      <ComponentRef Id="ServerDataDirectory" />
      <ComponentRef Id="ServerMachineSettings" />
      <ComponentRef Id="ServerInstallerConfiguration" />
      <ComponentRef Id="ServerTrayStartup" />
    </Feature>
  </Package>

  <Fragment>
    <Component Id="ServerTrayStartup" Directory="INSTALLFOLDER" Bitness="always64">
      <RegistryValue Root="HKLM"
                     Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Run"
                     Name="iWebClassroom Server"
                     Type="string"
                     Value="&quot;[INSTALLFOLDER]iWebClassroom.Server.Tray.exe&quot;"
                     KeyPath="yes" />
    </Component>

    <Component Id="ServerService" Directory="INSTALLFOLDER" Bitness="always64">
      <File Id="ServerExecutable"
            Source="$(var.PublishDir)\iWebClassroom.Server.exe"
            KeyPath="yes" />
      <fire:FirewallException Id="ServerHttpFirewall"
                              Name="iWebClassroom Server HTTP bootstrap"
                              Port="7080"
                              Protocol="tcp"
                              Scope="localSubnet"
                              Profile="all" />
      <fire:FirewallException Id="ServerHttpsFirewall"
                              Name="iWebClassroom Server HTTPS"
                              Port="7443"
                              Protocol="tcp"
                              Scope="localSubnet"
                              Profile="all" />
      <ServiceInstall Id="InstallServerService"
                      Name="iWebClassroom.Server"
                      DisplayName="iWebClassroom Server"
                      Description="iWebClassroom local classroom management server"
                      Type="ownProcess"
                      Start="auto"
                      ErrorControl="normal"
                      Vital="yes">
        <util:ServiceConfig FirstFailureActionType="restart"
                            SecondFailureActionType="restart"
                            ThirdFailureActionType="restart"
                            RestartServiceDelayInSeconds="30"
                            ResetPeriodInDays="1" />
      </ServiceInstall>
      <ServiceControl Id="ControlServerService"
                      Name="iWebClassroom.Server"
                      Start="install"
                      Stop="both"
                      Remove="uninstall"
                      Wait="yes" />
    </Component>

    <Component Id="ServerDataDirectory" Directory="SERVERDATADIR" Bitness="always64" Permanent="yes">
      <CreateFolder>
        <PermissionEx Sddl="D:PAI(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)" />
      </CreateFolder>
      <RegistryValue Root="HKLM"
                     Key="SOFTWARE\iWebClassroom\Server"
                     Name="DataDirectoryCreated"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>

    <Component Id="ServerMachineSettings"
               Directory="SERVERDATADIR"
               Bitness="always64"
               Permanent="yes"
               NeverOverwrite="yes">
      <File Id="ServerMachineSettingsFile"
            Source="$(var.InstallerSourceDir)\appsettings.Installer.json"
            Name="appsettings.Local.json"
            KeyPath="yes" />
    </Component>

    <Component Id="ServerInstallerConfiguration" Directory="SERVERDATADIR" Bitness="always64">
      <RegistryValue Root="HKLM"
                     Key="SOFTWARE\iWebClassroom\Server"
                     Name="InstallLanguage"
                     Type="string"
                     Value="[INSTALLLANGUAGE]"
                     KeyPath="yes" />
    </Component>
  </Fragment>
</Wix>
