<Window x:Class="IWebClassroom.Agent.MediaDisplayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" WindowState="Maximized" ResizeMode="NoResize" Topmost="True"
        Background="Black" ShowInTaskbar="True">
  <Grid Background="Black">
    <Image x:Name="MediaImage" Stretch="Uniform" Visibility="Collapsed" />
    <MediaElement x:Name="MediaVideo" Stretch="Uniform" LoadedBehavior="Manual" UnloadedBehavior="Stop"
                  Visibility="Collapsed" MediaEnded="MediaVideo_Ended" />
  </Grid>
</Window>
