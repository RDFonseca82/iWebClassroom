<Window x:Class="IWebClassroom.Agent.ScreenDisplayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ecrã do professor" WindowStyle="None" WindowState="Maximized"
        ResizeMode="NoResize" Topmost="True" Background="Black" ShowInTaskbar="True">
  <Grid>
    <Image x:Name="ScreenImage" Stretch="Uniform" />
    <Border VerticalAlignment="Top" HorizontalAlignment="Center" Margin="16" Padding="14,8" CornerRadius="6" Background="#D914231F">
      <TextBlock Text="Ecrã partilhado pelo professor" Foreground="White" FontWeight="SemiBold" />
    </Border>
  </Grid>
</Window>
