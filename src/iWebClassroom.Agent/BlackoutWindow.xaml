<Window x:Class="IWebClassroom.Agent.BlackoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False"
        Background="Black" Cursor="None">
  <Grid Background="Black">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
      <Image Source="{StaticResource BrandIcon}" Width="86" Height="86" Margin="0,0,0,22" />
      <TextBlock Text="iWebClassroom" Foreground="White" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center" />
      <TextBlock Text="{x:Static loc:AgentStrings.AttentionToTeacher}" xmlns:loc="clr-namespace:IWebClassroom.Agent.Localization"
                 Foreground="#AFC1D5" FontSize="18" Margin="0,10,0,0" HorizontalAlignment="Center" />
    </StackPanel>
  </Grid>
</Window>
