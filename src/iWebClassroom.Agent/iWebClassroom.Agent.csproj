<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RootNamespace>IWebClassroom.Agent</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <GeneratedApplicationIcon>$(MSBuildProjectDirectory)\obj\iWebClassroom.ico</GeneratedApplicationIcon>
    <ApplicationIcon>$(GeneratedApplicationIcon)</ApplicationIcon>
    <AssemblyName>iWebClassroom.Agent</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\iWebClassroom.Contracts\iWebClassroom.Contracts.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.15" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4370.26" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="apps.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="update.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(GeneratedApplicationIcon)" Link="iWebClassroom.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="GenerateApplicationIcon" BeforeTargets="CoreCompile"
          Inputs="$(MSBuildProjectDirectory)\..\..\scripts\Generate-AgentBrandIcon.ps1"
          Outputs="$(GeneratedApplicationIcon)">
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <Exec Command="pwsh -NoProfile -NonInteractive -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\Generate-AgentBrandIcon.ps1&quot; -OutputPath &quot;$(GeneratedApplicationIcon)&quot;" />
  </Target>
</Project>
