<Application x:Class="IWebClassroom.Agent.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <SolidColorBrush x:Key="InkBrush" Color="#14231F" />
    <SolidColorBrush x:Key="GreenBrush" Color="#176B57" />
    <SolidColorBrush x:Key="PaperBrush" Color="#F5F3EC" />
    <Style TargetType="Button">
      <Setter Property="Background" Value="{StaticResource GreenBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="16,9" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="9" />
      <Setter Property="Margin" Value="0,4,0,12" />
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="Padding" Value="9" />
      <Setter Property="Margin" Value="0,4,0,12" />
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Padding" Value="8" />
      <Setter Property="Margin" Value="0,4,0,12" />
    </Style>
  </Application.Resources>
</Application>
