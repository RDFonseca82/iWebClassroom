<Application x:Class="IWebClassroom.Agent.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <SolidColorBrush x:Key="InkBrush" Color="#14231F" />
    <SolidColorBrush x:Key="GreenBrush" Color="#176B57" />
    <SolidColorBrush x:Key="PaperBrush" Color="#F5F3EC" />
    <DrawingImage x:Key="BrandIcon">
      <DrawingImage.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="#07162D" Geometry="M 16,0 L 48,0 A 16,16 0 0 1 64,16 L 64,48 A 16,16 0 0 1 48,64 L 16,64 A 16,16 0 0 1 0,48 L 0,16 A 16,16 0 0 1 16,0 Z" />
          <GeometryDrawing Brush="#56E3C0" Geometry="M 12,18 L 32,9 L 52,18 L 52,46 L 32,56 L 12,46 Z" />
          <GeometryDrawing Brush="#07162D" Geometry="M 21,25 L 32,20 L 43,25 L 43,40 L 32,45 L 21,40 Z" />
          <GeometryDrawing Geometry="M 26,32 L 30,36 L 38,27">
            <GeometryDrawing.Pen><Pen Brush="#56E3C0" Thickness="4" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" /></GeometryDrawing.Pen>
          </GeometryDrawing>
        </DrawingGroup>
      </DrawingImage.Drawing>
    </DrawingImage>
    <Style TargetType="Button">
      <Setter Property="Background" Value="{StaticResource GreenBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="16,9" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="9" />
      <Setter Property="Margin" Value="0,4,0,12" />
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="Padding" Value="9" />
      <Setter Property="Margin" Value="0,4,0,12" />
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Padding" Value="8" />
      <Setter Property="Margin" Value="0,4,0,12" />
    </Style>
  </Application.Resources>
</Application>
