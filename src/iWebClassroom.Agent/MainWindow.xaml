<Window x:Class="IWebClassroom.Agent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:IWebClassroom.Agent.Localization"
        Title="iWebClassroom" Width="680" Height="650" MinWidth="560" MinHeight="560"
        Background="{StaticResource PaperBrush}" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Background="{StaticResource InkBrush}" Padding="28,22">
      <DockPanel>
        <StackPanel DockPanel.Dock="Left">
          <TextBlock Text="{x:Static loc:AgentStrings.AgentWindows}" Foreground="#78C7AD" FontSize="11" FontWeight="Bold" />
          <TextBlock Text="iWebClassroom" Foreground="White" FontFamily="Georgia" FontSize="31" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
          <TextBlock x:Name="StatusText" Text="{x:Static loc:AgentStrings.Disconnected}" Foreground="White" FontWeight="SemiBold" TextAlignment="Right" />
          <TextBlock x:Name="VersionText" Foreground="#B9CAC4" FontSize="11" TextAlignment="Right" />
        </StackPanel>
      </DockPanel>
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <Grid Margin="28">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="18" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Text="{x:Static loc:AgentStrings.Server}" FontWeight="SemiBold" />
          <TextBox x:Name="ServerUrlText" ToolTip="{x:Static loc:AgentStrings.ServerHint}" />

          <TextBlock Text="{x:Static loc:AgentStrings.EnrollmentCode}" FontWeight="SemiBold" />
          <PasswordBox x:Name="EnrollmentCodeText" ToolTip="{x:Static loc:AgentStrings.EnrollmentHint}" />

          <TextBlock Text="{x:Static loc:AgentStrings.ComputerName}" FontWeight="SemiBold" />
          <TextBox x:Name="DisplayNameText" />
        </StackPanel>

        <StackPanel Grid.Column="2">
          <TextBlock Text="{x:Static loc:AgentStrings.DefaultRoom}" FontWeight="SemiBold" />
          <TextBox x:Name="ClassroomText" />

          <TextBlock Text="{x:Static loc:AgentStrings.WorkstationType}" FontWeight="SemiBold" />
          <ComboBox x:Name="RoleCombo" SelectedIndex="0">
            <ComboBoxItem Content="{x:Static loc:AgentStrings.Student}" Tag="Student" />
            <ComboBoxItem Content="{x:Static loc:AgentStrings.Teacher}" Tag="Teacher" />
          </ComboBox>

          <TextBlock Text="{x:Static loc:AgentStrings.Identity}" FontWeight="SemiBold" />
          <TextBlock x:Name="IdentityText" Margin="0,7,0,15" Foreground="#67736F" TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </ScrollViewer>

    <Border Grid.Row="2" Background="White" BorderBrush="#DCDed6" BorderThickness="0,1,0,0" Padding="28,18">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <Button x:Name="ConnectButton" Content="{x:Static loc:AgentStrings.Connect}" Click="ConnectButton_Click" />
          <Button x:Name="ShareButton" Content="{x:Static loc:AgentStrings.ShareScreen}" Click="ShareButton_Click" Margin="10,0,0,0" IsEnabled="False" />
          <Button x:Name="StopShareButton" Content="{x:Static loc:AgentStrings.Stop}" Click="StopShareButton_Click" Margin="10,0,0,0" IsEnabled="False" Background="#A43D35" />
        </StackPanel>
        <TextBlock x:Name="ActivityText" Grid.Column="1" VerticalAlignment="Center" Foreground="#67736F" />
      </Grid>
    </Border>
  </Grid>
</Window>
