<Window x:Class="IWebClassroom.Agent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:IWebClassroom.Agent.Localization"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="iWebClassroom" Width="1020" Height="720" MinWidth="850" MinHeight="620"
        Icon="{StaticResource BrandIcon}" Background="{StaticResource CanvasBrush}" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="250" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="{StaticResource NavyBrush}">
      <Grid Margin="24,28,24,22">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
          <Image Source="{StaticResource BrandIcon}" Width="48" Height="48" Margin="0,0,12,0" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="iWebClassroom" Foreground="White" FontSize="19" FontWeight="Bold" />
            <TextBlock Text="{x:Static loc:AgentStrings.AgentWindows}" Foreground="#83A3C7" FontSize="10" FontWeight="Bold" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,42,0,0">
          <TextBlock Text="IWEBCLASSROOM" Foreground="#6685A8" FontSize="10" FontWeight="Bold" Margin="5,0,0,14" />
          <Border Background="#12315A" CornerRadius="10" Padding="14,13">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="▦" Foreground="{StaticResource MintBrush}" FontSize="20" Margin="0,0,12,0" />
              <TextBlock Text="{x:Static loc:AgentStrings.AgentWindows}" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="0,18,0,18">
          <Border Background="#0E2543" BorderBrush="#294564" BorderThickness="1" CornerRadius="12" Padding="13" Margin="0,0,0,10">
            <StackPanel>
              <TextBlock Text="{x:Static loc:AgentStrings.Connection}" Foreground="{StaticResource MintBrush}" FontSize="10" FontWeight="Bold" />
              <TextBlock Text="{x:Static loc:AgentStrings.Server}" Foreground="#7F9CBB" FontSize="10" Margin="0,9,0,2" />
              <TextBox x:Name="ServerUrlText" IsReadOnly="True" Foreground="White" Background="Transparent" BorderThickness="0" Padding="0" Margin="0" TextWrapping="Wrap" />
              <TextBlock Text="{x:Static loc:AgentStrings.ComputerName}" Foreground="#7F9CBB" FontSize="10" Margin="0,9,0,2" />
              <TextBox x:Name="DisplayNameText" IsReadOnly="True" Foreground="White" Background="Transparent" BorderThickness="0" Padding="0" Margin="0" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border Background="#0E2543" BorderBrush="#294564" BorderThickness="1" CornerRadius="12" Padding="13">
            <StackPanel>
              <TextBlock Text="{x:Static loc:AgentStrings.CentralManagement}" Foreground="{StaticResource MintBrush}" FontSize="10" FontWeight="Bold" />
              <TextBlock x:Name="AssignmentText" Foreground="White" FontWeight="SemiBold" Margin="0,9,0,0" TextWrapping="Wrap" />
              <TextBlock x:Name="IdentityText" Foreground="#7F9CBB" FontSize="9" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" />
              <TextBox x:Name="ClassroomText" Visibility="Collapsed" />
              <ComboBox x:Name="RoleCombo" SelectedIndex="0" Visibility="Collapsed"><ComboBoxItem Content="{x:Static loc:AgentStrings.Student}" Tag="Student" /><ComboBoxItem Content="{x:Static loc:AgentStrings.Teacher}" Tag="Teacher" /></ComboBox>
              <CheckBox x:Name="SharedComputerCheck" Visibility="Collapsed" Checked="SharedComputerCheck_Changed" Unchecked="SharedComputerCheck_Changed" />
              <PasswordBox x:Name="EnrollmentCodeText" Visibility="Collapsed" />
            </StackPanel>
          </Border>
        </StackPanel>
        <Border Grid.Row="3" Background="#0E2543" BorderBrush="#294564" BorderThickness="1" CornerRadius="14" Padding="16">
          <StackPanel>
            <TextBlock Text="{x:Static loc:AgentStrings.AgentStatus}" Foreground="#7F9CBB" FontSize="10" FontWeight="Bold" />
            <TextBlock x:Name="StatusText" Text="{x:Static loc:AgentStrings.Disconnected}" Foreground="{StaticResource MintBrush}"
                       FontSize="15" FontWeight="Bold" Margin="0,8,0,4" TextWrapping="Wrap" />
            <TextBlock x:Name="VersionText" Foreground="#8EA6C0" FontSize="11" />
            <Button x:Name="ConnectButton" Content="{x:Static loc:AgentStrings.Connect}" Click="ConnectButton_Click"
                    Margin="0,14,0,0" Visibility="Collapsed" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="82" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
        <Grid Margin="32,0">
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="iWebClassroom" Foreground="#7B8CA2" FontSize="11" />
            <TextBlock Text="{x:Static loc:AgentStrings.AgentWindows}" FontSize="22" FontWeight="Bold" />
          </StackPanel>
          <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#DFF8EF" CornerRadius="18" Padding="14,8">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="8" Height="8" Fill="#15956F" Margin="0,0,8,0" />
              <TextBlock Text="iWebClassroom" Foreground="#0B7B5C" FontWeight="Bold" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <Grid Grid.Row="1" Margin="32,28,32,28">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <Border x:Name="SharedRoomsPanel" Style="{StaticResource CardStyle}" Visibility="Collapsed">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="22" /><ColumnDefinition Width="270" /></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="{x:Static loc:AgentStrings.TemporaryRoom}" Foreground="{StaticResource BlueBrush}" FontSize="11" FontWeight="Bold" />
                <TextBlock Text="{x:Static loc:AgentStrings.JoinByCode}" FontSize="23" FontWeight="Bold" Margin="0,7,0,12" />
                <TextBlock Text="{x:Static loc:AgentStrings.JoinByCodeHelp}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" MaxWidth="430" HorizontalAlignment="Left" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="{x:Static loc:AgentStrings.StudentName}" Style="{StaticResource FieldLabelStyle}" />
                <TextBox x:Name="StudentNameText" MaxLength="100" />
                <TextBlock Text="{x:Static loc:AgentStrings.RoomCode}" Style="{StaticResource FieldLabelStyle}" />
                <TextBox x:Name="RoomCodeText" MaxLength="6" />
                <Button Content="{x:Static loc:AgentStrings.JoinRoom}" Click="JoinRoomButton_Click" />
              </StackPanel>
            </Grid>
          </Border>
        </ScrollViewer>
        <Border x:Name="TeacherConsolePanel" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="16" Visibility="Collapsed" ClipToBounds="True">
          <Grid>
            <wv2:WebView2 x:Name="TeacherConsole" />
            <Border x:Name="TeacherConsoleErrorPanel" Background="White" Visibility="Collapsed" Padding="32">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                <TextBlock Text="{x:Static loc:AgentStrings.TeacherConsoleUnavailable}" FontSize="20" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" />
                <TextBlock Text="{x:Static loc:AgentStrings.TeacherConsoleRuntimeHelp}" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,18" TextAlignment="Center" TextWrapping="Wrap" />
                <Button Content="{x:Static loc:AgentStrings.TryAgain}" Click="RetryTeacherConsole_Click" HorizontalAlignment="Center" />
              </StackPanel>
            </Border>
          </Grid>
        </Border>
      </Grid>

      <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="32,17">
        <Grid>
          <StackPanel Orientation="Horizontal">
            <Button x:Name="ShareButton" Content="{x:Static loc:AgentStrings.ShareScreen}" Click="ShareButton_Click" Margin="10,0,0,0" IsEnabled="False" Visibility="Collapsed" Style="{StaticResource SecondaryButtonStyle}" />
            <Button x:Name="StopShareButton" Content="{x:Static loc:AgentStrings.Stop}" Click="StopShareButton_Click" Margin="10,0,0,0" IsEnabled="False" Visibility="Collapsed" Style="{StaticResource DangerButtonStyle}" />
          </StackPanel>
          <TextBlock x:Name="ActivityText" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" MaxWidth="300" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
