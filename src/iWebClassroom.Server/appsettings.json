{
  "AllowedHosts": "*",
  "Security": {
    "RequireHttps": true
  },
  "Update": {
    "Enabled": false,
    "ManifestUrl": "https://github.com/RDFonseca82/iWebClassroom/releases/latest/download/server-stable.json",
    "SignerThumbprint": "",
    "CheckIntervalHours": 6,
    "ServiceName": "iWebClassroom.Server"
  },
  "Classroom": {
    "DataDirectory": "data",
    "ReleaseDirectory": "releases",
    "MaximumFrameBytes": 1500000,
    "MinimumFrameIntervalMilliseconds": 150,
    "AllowedApplicationIds": [ "notepad", "calculator" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
